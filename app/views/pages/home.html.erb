<div class="container">
  <h2>Welcome to SubPlatform</h2>
  <p>Explore premium content with simple monthly subscriptions.</p>

  <div class="plans">
    <div class="plan">
      <h3>Free Plan</h3>
      <p>Access limited articles</p>
      <button>Sign Up</button>
    </div>

    <div class="plan">
      <h3>Pro Plan</h3>
      <p>Access all content + exclusive posts</p>
      <button>Subscribe</button>
    </div>
    <% if user_signed_in? && current_user.plan %>
